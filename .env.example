# Workspace root path for clickable file links in error stack traces
# Set this to the absolute path of your workspace root directory
# Use '.' for the project root (resolved at build time)
# This enables clickable file links in error stack traces that open files in Cursor/VS Code
VITE_WORKSPACE_ROOT=/absolute/path/to/this/project/directory

# Base path for the application (usually '/' for root, or '/subdirectory' for subdirectory deployments)
VITE_APP_URL_ROOT_PATH=/

# Development server port
VITE_DEV_PORT=62776

# Trystero P2P configuration
VITE_TRYSTERO_APP_ID=Set-Your-App-Id-Here-123

# Supabase configuration (for P2P signaling)
VITE_SUPABASE_URL=https://find-your-supabase-project-id-and-put-it-here.supabase.co
VITE_SUPABASE_ANON_KEY=TODO-find-your-project-key-and-put-it-here

# Nostr relay URLs (comma-separated)
VITE_NOSTR_RELAYS=wss://relay.snort.social,wss://nosr.org,wss://relay.nostr.band,wss://relay.damus.io

# Build-time variables (set automatically by CI/CD, but required for local builds)
# For local development, use placeholder values
CF_PAGES_COMMIT_SHA=local
CF_PAGES_BRANCH=local
