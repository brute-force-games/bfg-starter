{
  "name": "bfg-starter",
  "private": true,
  "type": "module",
  "description": "Brute Force Games' shared site setup: @brute-force-games/site-setup (packages/site-setup), the presets every static site extends, and example/, a site that uses them all. The plan: the repo migration plan, \"The shared site setup\".",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "test": "vitest",
    "test:coverage": "d=$(mktemp -d \"${TMPDIR:-/tmp}/bfg-starter-coverage-XXXXXX\") && echo \"Coverage report: $d/index.html\" && vitest run --coverage --coverage.reportsDirectory=\"$d\"",
    "typecheck": "tsc -p packages/site-setup --noEmit && npm -w example run typecheck",
    "example:test": "npm -w example run test",
    "example:build": "npm -w example run build",
    "example:e2e": "npm -w example run test:e2e",
    "example:lint": "npm -w example run lint"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "astro": "7.4.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
