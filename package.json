{
  "name": "bfg-starter",
  "private": true,
  "type": "module",
  "description": "Brute Force Games' shared site setup: @brute-force-games/site-setup (packages/site-setup), the presets every static site extends, and example/, a site that uses them all. The plan: the repo migration plan, \"The shared site setup\".",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "test": "vitest",
    "test:coverage": "d=$(mktemp -d \"${TMPDIR:-/tmp}/bfg-starter-coverage-XXXXXX\") && echo \"Coverage report: $d/index.html\" && vitest run --coverage --coverage.reportsDirectory=\"$d\"",
    "typecheck": "tsc -p packages/site-setup --noEmit && npm -w example run typecheck",
    "lint": "oxlint --type-aware packages/site-setup vitest.config.ts oxfmt.config.ts knip.ts && knip --workspace packages/site-setup",
    "format": "oxfmt --ignore-path .gitignore packages/site-setup vitest.config.ts oxfmt.config.ts knip.ts .oxlintrc.json",
    "format:check": "oxfmt --check --ignore-path .gitignore packages/site-setup vitest.config.ts oxfmt.config.ts knip.ts .oxlintrc.json",
    "example:test": "npm -w example run test",
    "example:build": "npm -w example run build",
    "example:e2e": "npm -w example run test:e2e",
    "example:lint": "npm -w example run lint"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.0",
    "@playwright/test": "1.64.1",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "astro": "7.4.1",
    "jsdom": "29.1.1",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-complexity": "4.0.0",
    "oxlint-tsgolint": "7.0.2004",
    "pagefind": "1.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sarif-explorer": "0.1.0",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
