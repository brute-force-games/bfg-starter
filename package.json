{
  "name": "bfg-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "modules/bfg-engine",
    "modules/bfg-gdp-basic-games",
    "modules/bfg-gdp-party-games"
  ],
  "scripts": {
    "prebuild": "npm run test && npm run test:bdd",
    "dev": "vite dev",
    "build": "vite build",
    "build:gh-pages": "VITE_BASE_PATH=/bfg-starter/ vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "npm run test --workspaces --include-workspace-root --if-present",
    "test:bdd": "cross-env TS_NODE_PROJECT=tsconfig.cucumber.json cucumber-js --require-module ts-node/register --require tests/features/steps/**/*.ts tests/features/**/*.feature",
    "type-check": "tsc --noEmit",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.23.2",
    "@tanstack/react-router": "^1.132.2",
    "@tanstack/react-start": "^1.132.2",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tinybase": "^6.6.1",
    "uuid": "^13.0.0",
    "vite": "^7.1.7",
    "vite-plugin-checker": "^0.11.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@tanstack/router-cli": "^1.132.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "cucumber-tsflow": "^4.5.1",
    "playwright": "^1.55.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
