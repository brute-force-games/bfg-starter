---
import { getEntry, render } from "astro:content";
import BaseLayout from "@brute-force-games/site-setup/layouts/BaseLayout.astro";

const page = await getEntry("pages", "about");
if (page === undefined) {
  throw new Error("content/pages/about.md is missing");
}
const { Content } = await render(page);
---

<BaseLayout
  site="A site on the shared setup"
  title={page.data.title}
  description={page.data.description}
  nav={[{ href: "/", label: "Home" }, { href: "/about/", label: "About" }]}
>
  <h1>{page.data.title}</h1>
  <Content />
</BaseLayout>
