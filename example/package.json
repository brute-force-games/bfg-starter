{
  "name": "bfg-site-example",
  "private": true,
  "type": "module",
  "description": "A site on @brute-force-games/site-setup, every entry used: the setup's own end-to-end check, and what a new site's first files look like.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro sync && astro check && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "lint": "oxlint --type-aware"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@brute-force-games/site-setup": "*",
    "astro": "7.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
