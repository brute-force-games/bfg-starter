---
import "../styles/tokens.css";
import "../styles/global.css";
import { PageReadyStatus } from "../src/components/PageReadyStatus.tsx";

/**
 * A Brute Force Games site's page (@brute-force-games/site-setup/layouts/BaseLayout.astro): its
 * header (the site's name and nav), and the page's content on the shared tokens. Modelled on
 * site-bruteforce.games'. A site's theme overrides token values after this one's styles.
 *
 * The header ends with the page's ready status (bfg-core's docs/design-notes/ready-status.md):
 * `PageReadyStatus` unless the page fills the `status` slot, as a room's page does with the
 * room's own, so a page has one "Ready".
 */
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  /** The site's name, in the header and every page's title. */
  site: string;
  /** The page's title, before the site's name. */
  title: string;
  description: string;
  /** The site's sections, in the header's nav. */
  nav: readonly NavLink[];
}

const { site, title, description, nav } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · {site}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">{site}</a>
      <nav aria-label="Site">
        {nav.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
      <div class="status">
        <slot name="status"><PageReadyStatus client:load /></slot>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    gap: var(--space-6);
    align-items: baseline;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .brand {
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  .status {
    margin-left: auto;
  }
  nav {
    display: flex;
    gap: var(--space-4);
  }
  nav a {
    color: var(--color-accent);
  }
  main {
    max-width: var(--width-prose);
    margin: 0 auto;
    padding: var(--space-6);
  }
</style>
