{
  "name": "@brute-force-games/site-setup",
  "private": true,
  "type": "module",
  "description": "What every Brute Force Games static site shares, as presets a site extends: its Astro config, its test stages' Vitest config, its Playwright config and dev-server gate, its TypeScript, oxlint, knip and oxfmt bases, its style tokens and its base layout, its content collections, Storybook and integrations, and each run's HTML reports. The plan: the repo migration plan, \"The shared site setup\".",
  "exports": {
    "./astro": "./src/astro.ts",
    "./vitest": "./src/vitest.ts",
    "./tsconfig.json": "./tsconfig.base.json",
    "./playwright": "./src/playwright.ts",
    "./lint": "./oxlint.json",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/global.css": "./styles/global.css",
    "./layouts/BaseLayout.astro": "./layouts/BaseLayout.astro",
    "./knip": "./src/knip.ts",
    "./oxfmt": "./src/oxfmt.ts",
    "./storybook": "./src/storybook.ts",
    "./storybook/preview": "./src/storybookPreview.ts",
    "./integrations/storybook": "./src/integrations/astro/storybookRoute.ts",
    "./integrations/stale-code": "./src/integrations/astro/staleCode.ts",
    "./integrations/page-search": "./src/integrations/astro/pageSearch.ts",
    "./content": "./src/content.ts",
    "./lint/complexity": "./oxlint.complexity.json",
    "./reports/runs": "./src/reports/reportRuns.ts",
    "./reports/folder": "./src/reports/reportFolder.ts",
    "./reports/complexity": "./src/reports/complexityReport.ts",
    "./dev-server-caches": "./src/bin/devServerCaches.ts",
    "./coverage-minimum": "./src/bin/coverageMinimum.ts",
    "./components/PageReadyStatus": "./src/components/PageReadyStatus.tsx",
    "./components/useAllIslandsHydrated": "./src/components/useAllIslandsHydrated.ts",
    "./e2e": "./src/e2e.ts",
    "./e2e-guard": "./src/e2eGuard.ts"
  },
  "bin": {
    "bfg-site": "./src/bin/bfg-site.ts"
  },
  "dependencies": {
    "@brute-force-games/cases": "file:../../../bfg-core/platform/cases",
    "@brute-force-games/room-view": "file:../../../bfg-core/platform/room-view",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "@playwright/test": "^1.64.0",
    "@storybook/react-vite": "^10.6.0",
    "@vitest/ui": "^5.0.0",
    "astro": "^7.0.0",
    "knip": "^6.42.0",
    "oxfmt": ">=0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-complexity": "^4.0.0",
    "oxlint-tsgolint": ">=7.0.0",
    "pagefind": "^1.5.0",
    "react": "^19.0.0",
    "sarif-explorer": ">=0.1.0",
    "storybook": "^10.6.0",
    "vite": ">=7.0.0",
    "vitest": "^5.0.0"
  },
  "coverageMinimum": 100,
  "peerDependenciesMeta": {
    "@storybook/react-vite": {
      "optional": true
    },
    "@vitest/ui": {
      "optional": true
    },
    "oxlint-plugin-complexity": {
      "optional": true
    },
    "pagefind": {
      "optional": true
    },
    "sarif-explorer": {
      "optional": true
    },
    "storybook": {
      "optional": true
    }
  }
}
