{
  "name": "@brute-force-games/site-setup",
  "private": true,
  "type": "module",
  "description": "What every Brute Force Games static site shares, as presets a site extends: its Astro config, its test stages' Vitest config, its Playwright config and dev-server gate, its TypeScript, oxlint, knip and oxfmt bases, its style tokens and its base layout. The plan: the repo migration plan, \"The shared site setup\".",
  "exports": {
    "./astro": "./src/astro.ts",
    "./vitest": "./src/vitest.ts",
    "./tsconfig.json": "./tsconfig.base.json",
    "./playwright": "./src/playwright.ts",
    "./lint": "./oxlint.json",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/global.css": "./styles/global.css",
    "./layouts/BaseLayout.astro": "./layouts/BaseLayout.astro",
    "./knip": "./src/knip.ts",
    "./oxfmt": "./src/oxfmt.ts",
    "./storybook": "./src/storybook.ts",
    "./storybook/preview": "./src/storybookPreview.ts",
    "./integrations/storybook": "./src/integrations/astro/storybookRoute.ts",
    "./integrations/stale-code": "./src/integrations/astro/staleCode.ts",
    "./integrations/page-search": "./src/integrations/astro/pageSearch.ts",
    "./content": "./src/content.ts"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "@playwright/test": "^1.64.0",
    "@storybook/react-vite": "^10.6.0",
    "astro": "^7.0.0",
    "knip": "^6.42.0",
    "oxfmt": ">=0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": ">=7.0.0",
    "pagefind": "^1.5.0",
    "react": "^19.0.0",
    "storybook": "^10.6.0",
    "vite": ">=7.0.0",
    "vitest": "^5.0.0"
  },
  "coverageMinimum": 100,
  "peerDependenciesMeta": {
    "@storybook/react-vite": {
      "optional": true
    },
    "pagefind": {
      "optional": true
    },
    "storybook": {
      "optional": true
    }
  }
}
